{
  "name": "rednd-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:ios-frame": "node --no-warnings tools/build-ios-frame.cjs",
    "build:seo": "python3 tools/build_seo.py",
    "check:ios-frame": "node --no-warnings tools/build-ios-frame.cjs --check",
    "check:seo": "python3 tools/build_seo.py --check",
    "launch:check": "npm run check:seo && python3 tools/check_site.py",
    "test": "npm run check:seo && python3 tools/check_site.py && python3 -m unittest discover -s tests -v && node --check support.js && node --check site-config.js && npm run check:ios-frame"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0"
  }
}
